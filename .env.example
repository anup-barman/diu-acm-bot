# Telegram Bot Token from @BotFather
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Target Telegram Chat ID, Group ID, or Channel Username
# For a public channel: @your_channel_name
# For a private channel/group: -100xxxxxxxxxx
# For personal chat: your_user_id (e.g. 123456789)
# Multiple destinations can be separated by commas: @channel_one,-100123456789
TELEGRAM_CHAT_ID=@diu_acm_notices

# Timezone for displaying contest start time and date
# Default is Asia/Dhaka (Bangladesh Standard Time: UTC+6)
TIMEZONE=Asia/Dhaka

# How often (in minutes) the background worker checks for upcoming contests
CHECK_INTERVAL_MINUTES=15

# How many hours before contest start to send the reminder
# Default is 24 hours (1 day before)
REMINDER_HOURS_BEFORE=24.0

# Disable link preview in Telegram messages (true or false)
DISABLE_WEB_PAGE_PREVIEW=true
